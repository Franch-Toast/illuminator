# Core runtime configuration. Pipeline assembly belongs to the caller.
global:
  log_level: info
  log_file: ""
  log_max_size: 10485760
  log_max_files: 3
  data_dir: ./data
  plugin_dirs: []

engine:
  collect_pool_threads: 2
  sink_pool_threads: 4
  channel:
    size: medium                     # small(1024) | medium(4096) | large(16384)
    drop_policy: drop_newest          # drop_newest | drop_oldest
    backpressure_high: 0.8
    backpressure_low: 0.2
